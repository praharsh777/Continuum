# Continuum Environment Configuration

# Hindsight Cloud API Key (from https://ui.hindsight.vectorize.io)
HINDSIGHT_API_KEY=your_hindsight_api_key_here

# Hindsight API Base URL (defaults to Hindsight Cloud)
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io

# Hindsight Memory Bank ID
HINDSIGHT_BANK_ID=continuum-demo

# Groq API Key (from https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# LLM Models
GROQ_PRIMARY_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=qwen/qwen3-32b
